// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client"
  output   = "../node_modules/.prisma/client"
}

enum UserRole {
  ADMIN
  MANAGER
  MEMBER
}

enum ContactStatus {
  LEAD
  PROSPECT
  CUSTOMER
  ARCHIVED
}

enum DealStage {
  QUALIFY
  PITCH
  NEGOTIATE
  WON
  LOST
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETE
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum ChatChannelType {
  TEAM
  DEAL
  PROJECT
  SUPPORT
  AI
}

model Tenant {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  plan        String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  users       User[]
  contacts    Contact[]
  deals       Deal[]
  projects    Project[]
  tasks       Task[]
  chatChannels ChatChannel[]
  chatMessages ChatMessage[]
  insights    AgentInsight[]

  @@index([slug])
}

model User {
  id           String        @id @default(cuid())
  name         String?
  email        String        @unique
  passwordHash String
  role         UserRole      @default(MEMBER)
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  emailVerified DateTime?
  contacts     Contact[]     @relation("ContactOwner")
  deals        Deal[]        @relation("DealOwner")
  tasks        Task[]        @relation("TaskAssignee")
  projects     Project[]     @relation("ProjectOwner")
  chatMessages ChatMessage[]
  accounts     Account[]
  sessions     Session[]

  @@index([tenantId])
}

model Contact {
  id        String        @id @default(cuid())
  tenantId  String
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerId   String?
  owner     User?         @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  name      String
  email     String?
  phone     String?
  company   String?
  status    ContactStatus @default(LEAD)
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deals     Deal[]

  @@index([tenantId])
  @@index([ownerId])
}

model Deal {
  id            String     @id @default(cuid())
  tenantId      String
  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contactId     String?
  contact       Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  ownerId       String?
  owner         User?      @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  name          String
  value         Float      @default(0)
  stage         DealStage  @default(QUALIFY)
  expectedClose DateTime?
  notes         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([tenantId])
  @@index([ownerId])
  @@index([contactId])
}

model Project {
  id          String        @id @default(cuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerId     String?
  owner       User?         @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  name        String
  description String?
  status      ProjectStatus @default(PLANNING)
  dueDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  tasks       Task[]

  @@index([tenantId])
  @@index([ownerId])
}

model Task {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assigneeId  String?
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([tenantId])
  @@index([projectId])
  @@index([assigneeId])
}

model ChatChannel {
  id         String          @id @default(cuid())
  tenantId   String
  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  type       ChatChannelType @default(TEAM)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  messages   ChatMessage[]

  @@index([tenantId])
}

model ChatMessage {
  id        String      @id @default(cuid())
  tenantId  String
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channelId String
  channel   ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  content   String
  isAgent   Boolean     @default(false)
  createdAt DateTime    @default(now())

  @@index([tenantId])
  @@index([channelId])
  @@index([authorId])
}

model AgentInsight {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title     String
  summary   String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([tenantId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
